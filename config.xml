<?xml version='1.0' encoding='utf-8'?>
<widget id="com.throne.candyquestpro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Candy Quest Pro</name>
    <description>Sweet Match-3 Puzzle Adventure Game</description>
    <author email="mohdadil3795@gmail.com" href="https://candyquestpro.app">
        Throne Games
    </author>
    <content src="index.html" />
    
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />

    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-compileSdkVersion" value="35" />
    <preference name="android-targetSdkVersion" value="35" />
    <preference name="BackgroundColor" value="0xfff6d365" />

    <platform name="android">
        <icon src="icon.png" />
    </platform>

    <plugin name="admob-plus-cordova" spec="^2.0.0">
        <variable name="APP_ID_ANDROID" value="ca-app-pub-2255298899514160~1925829210" />
    </plugin>
</widget>
